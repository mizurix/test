local SharedFiles = (function()
-- Double-buffered JSON records. Each key has one writer; readers keep the newest valid slot.
local Files = {}
Files.__index = Files

function Files.new(api, codec, folder)
    for _, name in ipairs({ "readfile", "writefile", "isfile", "isfolder", "makefolder", "listfiles" }) do
        assert(type(api[name]) == "function", "Shared file API unavailable: " .. name)
    end
    assert(folder:match("^[%w_/-]+$") and not folder:find("%.%.", 1, true), "Invalid sync folder")
    if not api.isfolder(folder) then api.makefolder(folder) end
    return setmetatable({ api = api, codec = codec, folder = folder, sequences = {}, cache = {} }, Files)
end

local function safeKey(key)
    assert(type(key) == "string" and key:match("^[%w_-]+$"), "Invalid record key")
    return key
end

function Files:Write(key, payload)
    key = safeKey(key)
    if not self.sequences[key] then
        self:Read(key)
        self.sequences[key] = self.cache[key] and self.cache[key].sequence or 0
    end
    local sequence = (self.sequences[key] or 0) + 1
    local envelope = { protocol = 1, sequence = sequence, payload = payload }
    local slot = sequence % 2 == 0 and "a" or "b"
    local ok, err = pcall(function()
        self.api.writefile(self.folder .. "/" .. key .. "-" .. slot .. ".json", self.codec.encode(envelope))
    end)
    if not ok then return false, tostring(err) end
    self.sequences[key] = sequence
    return true
end

function Files:Read(key, validate)
    key = safeKey(key)
    local best
    for _, slot in ipairs({ "a", "b" }) do
        local path = self.folder .. "/" .. key .. "-" .. slot .. ".json"
        local ok, envelope = pcall(function()
            if not self.api.isfile(path) then return nil end
            return self.codec.decode(self.api.readfile(path))
        end)
        local accepted = true
        if ok and type(envelope) == "table" and type(envelope.payload) == "table" and validate then
            local valid, result = pcall(validate, envelope.payload)
            accepted = valid and result == true
        end
        if ok and type(envelope) == "table" and envelope.protocol == 1
            and type(envelope.sequence) == "number" and type(envelope.payload) == "table"
            and accepted
            and (not best or envelope.sequence > best.sequence) then best = envelope end
    end
    if best then self.cache[key] = best end
    return best and best.payload or nil
end

return Files

end)()
local TargetRegistry = (function()
-- Leader-issued opaque target IDs; followers resolve replicated identity or unambiguous position.
local Registry = {}
Registry.__index = Registry

local function distance(a, b)
    local x, y, z = a[1] - b[1], a[2] - b[2], a[3] - b[3]
    return math.sqrt(x * x + y * y + z * z)
end

function Registry.new(epoch)
    return setmetatable({ epoch = epoch, nextId = 0, byObject = setmetatable({}, { __mode = "k" }), live = {} }, Registry)
end

function Registry:Snapshot(candidates)
    local descriptors, live = {}, {}
    for _, candidate in ipairs(candidates) do
        if candidate.alive and candidate.object and type(candidate.name) == "string" and type(candidate.position) == "table" then
            local key = self.byObject[candidate.object]
            if not key then
                self.nextId = self.nextId + 1
                key = self.epoch .. "-enemy-" .. self.nextId
                self.byObject[candidate.object] = key
            end
            local descriptor = { key = key, name = candidate.name, position = table.clone(candidate.position),
                stableId = candidate.stableId, alive = true, objective = candidate.objective == true }
            table.insert(descriptors, descriptor)
            live[key] = candidate.object
        end
    end
    self.live = live
    return descriptors
end

function Registry.Resolve(descriptor, candidates, cached, maxDistance, ambiguityMargin)
    if not descriptor then return nil, "No target descriptor." end
    maxDistance, ambiguityMargin = maxDistance or 100, ambiguityMargin or 8
    local best, bestDistance, nextDistance = nil, math.huge, math.huge
    local stableMatches = {}
    for _, candidate in ipairs(candidates) do
        if candidate.alive and candidate.name == descriptor.name and candidate.object then
            if descriptor.stableId ~= nil and candidate.stableId == descriptor.stableId then
                table.insert(stableMatches, candidate.object)
            elseif descriptor.stableId == nil then
                local delta = distance(candidate.position, descriptor.position)
                if candidate.object == cached and delta <= maxDistance then return cached end
                if delta < bestDistance then
                    nextDistance, bestDistance, best = bestDistance, delta, candidate.object
                elseif delta < nextDistance then nextDistance = delta end
            end
        end
    end
    if descriptor.stableId ~= nil then
        if #stableMatches == 1 then return stableMatches[1] end
        return nil, #stableMatches > 1 and "Replicated target ID is not unique." or "Assigned target is not streamed in."
    end
    if not best or bestDistance > maxDistance then return nil, "Assigned target is outside the local view." end
    if nextDistance - bestDistance < ambiguityMargin then return nil, "Same-name enemies overlap; waiting for an unambiguous target." end
    return best
end

return Registry

end)()

    state.detail = cardAuto.error or "Gun upgrades first; otherwise a random card."
    if #choices < 3 or now - cardAuto.seenAt < Config.CardAppearDelay then return true end
    local selected
    for _, choice in ipairs(choices) do
        if choice.button == cardAuto.button then selected = choice break end
    end
    if not selected then
        local best, pool = -1, {}
        for _, choice in ipairs(choices) do
            if choice.score > best then best, pool = choice.score, {} end
            if choice.score == best then table.insert(pool, choice) end
        end
        selected = pool[math.random(1, #pool)]
        cardAuto.button, cardAuto.title = selected.button, selected.text
        cardAuto.attempts, cardAuto.lastAttempt = 0, -math.huge
    end
    if cardAuto.attempts >= Config.CardMaxAttempts then
        state.detail = "Automatic selection was not confirmed. Choose one card manually."
        return true
    end
    if now - cardAuto.lastAttempt < Config.CardRetryDelay then return true end
    if (type(firesignal) ~= "function" or cardAuto.attempts >= 2) and not windowFocused then
        state.detail = "Signal activation is unavailable or unconfirmed; mouse fallback is waiting for Roblox focus."
        return true
    end
    cardAuto.attempts = cardAuto.attempts + 1
    cardAuto.lastAttempt = now
    local token, button = cardAuto.token, selected.button
    local ok, err = pcall(function()
        local signalName
        if type(firesignal) == "function" then
            signalName = cardAuto.attempts == 2 and "Activated" or "MouseButton1Click"
            if type(getconnections) == "function" and cardAuto.attempts == 1 then
                local click = getconnections(button.MouseButton1Click)
                local activated = getconnections(button.Activated)

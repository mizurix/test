        assert(VirtualInputManager, "Mouse input is unavailable; choose the card manually.")
        local x, y = cardClickPosition(selected)
        assert(x, "Card is covered by another UI; waiting for a clear click position.")
        cardAuto.method = "mouse"
        cardAuto.mouseX, cardAuto.mouseY, cardAuto.mouseHeld = x, y, true
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.delay(0.05, function()
            if cardAuto.token == token then releaseCardMouse() end
        end)
    end)
    if cardAuto.token == token then cardAuto.error = not ok and tostring(err) or nil end
    if not ok then releaseCardMouse() end
    return true
end

local function holdCharacter(character, root)
    if movementRoot ~= root then
        releaseMovement()
        movementRoot = root
    end
    if not hoverBody or not hoverBody.Parent then
        hoverBody = Instance.new("BodyVelocity")
        hoverBody.Name = "DragonstormDungeonHold"
        hoverBody.MaxForce = Vector3.new(100000, 100000, 100000)
        hoverBody.Velocity = Vector3.zero
        hoverBody.Parent = root
    end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            if collisionStates[part] == nil then
                collisionStates[part] = part.CanCollide
            end
            part.CanCollide = false
        end
    end
end

local function isObjective(enemy)
    local id = enemy and enemy:GetAttribute("ID")
    return dungeonFolder() ~= nil and enemy and enemy.Name == "PropHitboxPlaceholder"
        and enemy:GetAttribute("HealthEnabled") == false and type(id) == "number" and id > 0
end

local function priorityTargets(targets, root)
    local ownRoom = partyWanted and root and roomAt(root)
    if ownRoom then
        local here = {}
        for _, target in ipairs(targets) do
            local targetRoot = target:FindFirstChild("HumanoidRootPart")
            local targetRoom = targetRoot and roomAt(targetRoot)
            if not targetRoom or targetRoom.key == ownRoom.key then table.insert(here, target) end
        end
        targets = here
    end
    local props = {}
    for _, target in ipairs(targets) do if isObjective(target) then table.insert(props, target) end end
    state.objectiveCount = #props
    return #props > 0 and props or targets
end

local function enemyParts(enemy, origin)
    local folder = workspace:FindFirstChild("Enemies")
    if not folder or not enemy or not enemy:IsA("Model")
        or not enemy:IsDescendantOf(folder) or Players:GetPlayerFromCharacter(enemy) then
        return
    end
    local humanoid = enemy:FindFirstChildOfClass("Humanoid")
    local root = enemy:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") and (root.Position - origin.Position).Magnitude <= Config.ScanRadius then
        if isObjective(enemy) then
            if not humanoid or humanoid.Health > 0 then return humanoid or enemy, root end
        elseif humanoid and humanoid.Health > 0 then return humanoid, root end
    end
end

local function collectTargets(root)
    if targetCache.root == root and os.clock() - targetCache.time < 0.15 then
        local live = {}
        for _, target in ipairs(targetCache.targets) do if enemyParts(target, root) then table.insert(live, target) end end
        return priorityTargets(live, root)
    end
    local targets = {}
    local function scanNPC(node, depth)
        if not node then
            return
        end
        for _, child in ipairs(node:GetChildren()) do
            local humanoid, enemyRoot = enemyParts(child, root)
            if humanoid and enemyRoot then
                table.insert(targets, child)
            elseif depth < 3 and not child:IsA("BasePart") then
                scanNPC(child, depth + 1)
            end
        end
    end
    scanNPC(workspace:FindFirstChild("Enemies"), 0)
    targetCache = { root = root, time = os.clock(), targets = targets }
    return priorityTargets(targets, root)
end

local function describeTarget(enemy, root)
    local _, part = enemyParts(enemy, root)
    if not part then return end
    local objective = isObjective(enemy)
    local stable = objective and "prop:" .. tostring(enemy:GetAttribute("ID")) or enemy:GetAttribute("UniqueId")
    return { object = enemy, name = enemy.Name, alive = true, objective = objective == true,
        position = { part.Position.X, part.Position.Y, part.Position.Z },
        stableId = (type(stable) == "string" or type(stable) == "number") and tostring(stable) or nil }
end

local function describeTargets(targets, root)
    local list = {}
    for _, enemy in ipairs(targets) do
        local descriptor = describeTarget(enemy, root)
        if descriptor then table.insert(list, descriptor) end
    end
    return list
end

local function chooseTarget(root, targets)
    -- Keep the movement center stable while the source aura picks its own nearest hit.
    if state.target and table.find(targets, state.target) then
        return state.target
    end
    return targets[1]
end

local limbParts = {
    "Head", "UpperTorso", "LowerTorso",
    "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm",
    "LeftUpperLeg", "RightUpperLeg", "LeftLowerLeg", "RightLowerLeg",
    "HumanoidRootPart",
}

local function chooseShotPart(root, targets)
    local nearest, nearestDistance = nil, Config.ShotRange
    for _, enemy in ipairs(targets) do
        local _, enemyRoot = enemyParts(enemy, root)
        if enemyRoot then
            local distance = (enemyRoot.Position - root.Position).Magnitude
            if distance < nearestDistance then
                nearest, nearestDistance = enemy, distance
            end
        end
    end
    if not nearest then
        return
    end
    local available = {}
    for _, name in ipairs(limbParts) do
        local part = nearest:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            table.insert(available, part)
        end
    end
    if #available > 0 then
        return available[math.random(1, #available)]
    end
end

local function moveAbove(root, targetRoot)
    local now = os.clock()
    if orbitTarget ~= targetRoot then
        cancelTween()
        orbitTarget, orbitAngle, orbitActive, lastOrbitTime = targetRoot, 0, false, now
        local config = partyWanted and partyRuntime and partyRuntime.config
        local member = config and PartyCore.Member(config, player.UserId)
        if member then orbitAngle = math.pi * 2 * (member.slot - 1) / config.count end
    end
    local center = targetRoot.Position + Vector3.new(0, Config.HoverHeight, 0)
    if orbitActive then
        local delta = math.clamp(now - lastOrbitTime, 0, 0.1)
        lastOrbitTime = now
        orbitAngle = (orbitAngle + math.pi * 2 / Config.OrbitPeriod * delta) % (math.pi * 2)
        local orbitGoal = center + Vector3.new(
            math.cos(orbitAngle) * Config.OrbitRadius, 0,
            math.sin(orbitAngle) * Config.OrbitRadius)
        if (orbitGoal - root.Position).Magnitude <= Config.MoveSpeed * delta + 5 then
            root.CFrame = CFrame.lookAt(orbitGoal, targetRoot.Position)
            return true
        end
        -- A distant or teleported target needs a new approach, not a position snap.
        orbitActive = false
    end
    local goal = center + Vector3.new(
        math.cos(orbitAngle) * Config.OrbitRadius, 0,
        math.sin(orbitAngle) * Config.OrbitRadius)
    local distance = (root.Position - goal).Magnitude
    if distance <= 2 then
        cancelTween()
        orbitActive, lastOrbitTime = true, now
        root.CFrame = CFrame.lookAt(goal, targetRoot.Position)
        return true
    end
    if movementTween and movementTween.PlaybackState == Enum.PlaybackState.Playing
        and movementGoal and (movementGoal - goal).Magnitude < 6 then
        return false
    end
    cancelTween()
    movementGoal = goal
    movementTween = TweenService:Create(root,
        TweenInfo.new(math.max(distance / Config.MoveSpeed, 0.05), Enum.EasingStyle.Linear),
        { CFrame = CFrame.lookAt(goal, targetRoot.Position) })
    movementTween:Play()
    return false
end

local function shootDragonstorm(tool, character, targetRoot, remote, validator)
    -- Recheck the exact equipped Tool immediately before the source's shot pair.
    if tool.Name ~= "Dragonstorm" or tool.Parent ~= character then
        return
    end
    if os.clock() - state.lastShot < Config.ShotInterval then
        return
    end
    state.lastShot = os.clock()
    local values = shotValues(shootFunction, shotIndices)
    assert(values, "Dragonstorm shot state changed; restart farming to rediscover its controller.")

    -- Same sequence and Validator2 -> ShootGunEvent order as find dragon aura.lua.
    local carry = values.low * values.multiplier2
    local combined = (values.high * values.multiplier2 + values.low * values.multiplier) % values.modulus
    combined = (combined * values.modulus + carry) % values.limit
    local high = math.floor(combined / values.modulus)
    local low = combined - high * values.modulus
    local counter = values.counter + 1
    debug.setupvalue(shootFunction, shotIndices.high, high)
    debug.setupvalue(shootFunction, shotIndices.low, low)
    debug.setupvalue(shootFunction, shotIndices.counter, counter)
    validator:FireServer(math.floor(combined / values.limit * 16777215), counter)
    remote:FireServer(targetRoot.Position, { targetRoot })
    state.shots = state.shots + 1
end

local function waitFor(status, detail)
    state.status, state.detail = status, detail
    state.target = nil
    releaseMovement()
end

local function runAbility(name, callback)
    local ok, err = pcall(callback)
    if not state.running then
        return
    end
    if ok then
        state.abilityErrors[name] = nil
    else
        local message = tostring(err)
        if state.abilityErrors[name] ~= message then
            warn("[Kaitun Dungeon / " .. name .. "] " .. message)
        end
        state.abilityErrors[name] = message
    end
end

local function supportStep()
    if not state.farming or not dungeonFolder() then
        return
    end
    local character = characterParts()
    if not character then
        return
    end
    local now = os.clock()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    local commF = remotes and remotes:FindFirstChild("CommF_")
    local commE = remotes and remotes:FindFirstChild("CommE")

    if state.abilities.Haki and not character:FindFirstChild("HasBuso")
        and not hakiBusy and now - lastAbility.Haki >= 1 then
        lastAbility.Haki = now
        if commF and commF:IsA("RemoteFunction") then
            hakiBusy = true
            task.spawn(function()
                runAbility("Haki", function()
                    if state.running and not state.teleporting and state.farming and state.abilities.Haki and player.Character == character then
                        commF:InvokeServer("Buso")
                    end
                end)
                hakiBusy = false
            end)
        else
            state.abilityErrors.Haki = "CommF_ is unavailable."
        end
    end
    if state.abilities.Ken and now - lastAbility.Ken >= 2 then
        lastAbility.Ken = now
        runAbility("Ken", function()
            assert(commE and commE:IsA("RemoteEvent"), "CommE is unavailable.")
            commE:FireServer("Ken", true)
        end)
    end
    if state.abilities.V3 and now - lastAbility.V3 >= 30 then
        lastAbility.V3 = now
        runAbility("V3", function()
            assert(commE and commE:IsA("RemoteEvent"), "CommE is unavailable.")
            commE:FireServer("ActivateAbility")
        end)
    end
    local energy = character:FindFirstChild("RaceEnergy")
    local transformed = character:FindFirstChild("RaceTransformed")
    if state.abilities.V4 and energy and energy.Value == 1
        and not (transformed and transformed.Value) and now - lastAbility.V4 >= 1 then
        lastAbility.V4 = now
        runAbility("V4", function()
            assert(VirtualInputManager, "VirtualInputManager is unavailable.")
            v4KeyDown = true
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Y, false, game)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Y, false, game)
            v4KeyDown = false
        end)
        releaseV4Key()
    end
end

local function automaticExit(root)
    local now = os.clock()
    local dungeon = dungeonFolder()
    if state.dungeon ~= dungeon then
        state.dungeon = dungeon
        state.emptySince = nil
        state.exitArmed = true
        state.exitPosition = nil
        table.clear(usedExits)
    end
    if now < state.nextRoomAt then
        waitFor("Waiting for the next room", "Auto farm is on and will resume when enemies appear.")
        return
    end
    if not state.exitArmed then
        -- A server teleport away from the last exit allows another empty room.
        if state.exitPosition and (root.Position - state.exitPosition).Magnitude > 100 then
            state.exitArmed = true
            state.emptySince = nil
        else
            waitFor("Waiting for the next wave", "The exit was already used; waiting for enemies or a room transition.")
            return
        end
    end
    state.emptySince = state.emptySince or now
    local clearDelay = partyWanted and state.sawRoomTargets and 0.5 or Config.EmptyRoomDelay
    if now - state.emptySince < clearDelay then
        waitFor("Checking that the room is clear", "Confirming no enemies remain before using the exit.")
        return
    end
    local closest, bestDistance = nil, Config.AutoExitRadius
    for _, room in ipairs(dungeon:GetChildren()) do
        local exit = room:FindFirstChild("ExitTeleporter")
        local part = exit and exit:FindFirstChild("Root")
        if part and part:IsA("BasePart") then
            local distance = (root.Position - part.Position).Magnitude
            local usedPosition = usedExits[part]
            local alreadyUsed = usedPosition and (part.Position - usedPosition).Magnitude < 5
            if not alreadyUsed and distance < bestDistance then
                closest, bestDistance = part, distance
            end
        end
    end
    if not closest then
        waitFor("Waiting for a nearby exit", "No unused exit within 1,200 studs. Auto farm remains on.")
        return
    end
    releaseMovement()
    state.target = nil
    state.emptySince = nil
    state.exitArmed = false
    state.exitPosition = closest.Position
    state.nextRoomAt = now + Config.ExitSettleTime
    usedExits[closest] = closest.Position
    root.CFrame = closest.CFrame * CFrame.new(0, 3, 0)
    state.status = "Entering the next room"
    state.detail = "Auto farm stays on and will continue in the next room."
end

local function recoverPartyRoom(root, goal)
    local room, now = roomAt(root), os.clock()
    if not room or room.key ~= goal.fromRoom or not room.exit or not room.exit.Parent then
        waitFor("Finding the party route", "Waiting for the current room's exit to load.")
        return
    end
    local exit = room.exit
    if catchUp.root ~= root or catchUp.exit ~= exit then catchUp = { root = root, exit = exit, attempts = 0, nextAt = 0 } end
    state.recoveringRoom = goal.roomKey
    waitFor("Rejoining the party room", "Using this room's exit to rejoin the active party.")
    if now < catchUp.nextAt then return end
    if catchUp.attempts >= 3 then catchUp.attempts, catchUp.nextAt = 0, now + 4 return end
    -- A respawn may reuse an exit already consumed before death. Recovery has its
    -- own bounded retry latch; normal clear consensus/used-exit rules stay intact.
    root.CFrame = exit.CFrame * CFrame.new(0, 3, 0)
    catchUp.attempts, catchUp.nextAt = catchUp.attempts + 1, now + 1.5
    state.emptySince = nil
end

local function farmStep()
    if not state.farming then
        return
    end
    local character, humanoid, root = characterParts()
    if not character then
        waitFor("Waiting for your character", "Farming resumes after you respawn.")
        return
    end
    if lobbyAdapter and lobbyAdapter:Phase() == "lobby" then
        state.status = partyRuntime and partyRuntime.status or "Configure your lobby party"
        state.detail = syncError or "Confirm leader and members, then start the party on each account."
        return -- Lobby adapter owns movement; do not cancel its pad tween here.
    end
    local dungeon = dungeonFolder()
    if not dungeon then
        state.dungeon = nil
        state.emptySince = nil
        waitFor("Waiting for the dungeon", "Enter a dungeon first; Map.Dungeon is not loaded.")
        return
    end
    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then
        state.emptySince = nil
        waitFor("Waiting for enemies", "The Enemies folder is still loading; auto-exit is waiting too.")
        return
    end
    if state.dungeon ~= dungeon then
        state.dungeon = dungeon
        state.emptySince = nil
        state.exitArmed = true
        state.exitPosition = nil
        state.nextRoomAt = 0
        table.clear(usedExits)
    end
    local targets = collectTargets(root)
    local currentRoom = roomAt(root)
    local roomKey = currentRoom and currentRoom.key
    if state.combatRoomKey ~= roomKey then
        state.combatRoomKey, state.sawRoomTargets, state.emptySince = roomKey, false, nil
    end
    if #targets > 0 then state.sawRoomTargets = true end
    if cardAuto.active and cardAuto.movementBlocked then
        releaseMovement()
        state.status, state.detail = "Choosing a dungeon card", "Holding position for the card's mouse click."
        return
    end
    local goal = partyWanted and partyRuntime and partyRuntime:GetRecoveryGoal() or nil
    state.recoveringRoom = nil
    if goal and not cardAuto.active then
        recoverPartyRoom(root, goal)
        return
    end
    catchUp = {}
    -- Respawns put the gun in the Backpack. Re-equip before waiting for an
    -- assignment so the independent aura also works after a manual room return.
    local tool = #targets > 0 and findDragonstorm(character) or nil
    if tool and tool.Parent ~= character then
        releaseMovement()
        humanoid:EquipTool(tool)
        state.status, state.detail = "Equipping Dragonstorm", "Preparing Dragonstorm for combat."
        return
    end
    if partyWanted then
        local previousTarget = state.target
        state.target = partyRuntime and partyRuntime:GetTarget() or nil
        if state.target and not table.find(targets, state.target) then state.target = nil end
        if not state.target and #targets > 0 and partyRuntime then
            state.target = partyRuntime:SelectLocalTarget(describeTargets(targets, root), previousTarget)
        end
        if not state.target and #targets > 0 then
            waitFor(state.aura == "Active" and "Dragonstorm aura active" or "Synchronizing party targets",
                partyRuntime and partyRuntime.status or syncError or "Start party coordination in the lobby.")
            return
        end
    else state.target = chooseTarget(root, targets) end
    if not state.target then
        if cardAuto.active then
            waitFor("Choosing a dungeon card", "The exit will resume after the card choice is confirmed.")
            return
        end
        if partyWanted and not (partyRuntime and partyRuntime:CanAdvance()) then
            waitFor("Verifying party room clear", partyRuntime and partyRuntime.status or "Waiting for party confirmation.")
            return
        end
        automaticExit(root)
        return
    end
    state.emptySince = nil
    state.exitArmed = true
    state.exitPosition = nil
    tool = tool or findDragonstorm(character)
    if not tool then
        waitFor("Dragonstorm not found", "Place Dragonstorm in your Backpack. No other weapon will be used.")
        return
    end
    if tool.Parent ~= character then
        releaseMovement()
        humanoid:EquipTool(tool)
        state.status, state.detail = "Equipping Dragonstorm", "Your weapon is locked to Dragonstorm."
        return
    end
    local _, targetRoot = enemyParts(state.target, root)
    if not targetRoot then
        return
    end
    holdCharacter(character, root)
    local orbitReady = moveAbove(root, targetRoot)
    if not orbitReady then
        local goal = targetRoot.Position + Vector3.new(math.cos(orbitAngle) * Config.OrbitRadius,
            Config.HoverHeight, math.sin(orbitAngle) * Config.OrbitRadius)
        local remaining = (goal - root.Position).Magnitude
        local now = os.clock()
        if not movementWatch or movementWatch.target ~= state.target
            or (movementWatch.center - targetRoot.Position).Magnitude > 6
            or remaining < movementWatch.best - 3 then
            movementWatch = { target = state.target, center = targetRoot.Position, best = remaining, time = now }
        elseif now - movementWatch.time > 8 then
            releaseMovement()
            if partyWanted and partyRuntime then
                partyRuntime.unresolved, partyRuntime.unresolvedKey, partyRuntime.cachedTarget = true, partyRuntime.cachedTargetKey, nil
            end
            state.status, state.detail = "Retrying movement", "No approach progress for eight seconds; rebuilding the route."
            return
        end
    else movementWatch = nil end
    local distance = (targetRoot.Position - root.Position).Magnitude
    state.status = orbitReady and "Orbiting / Dragonstorm aura" or "Moving above target"
    state.detail = string.format("%s  |  %d studs", state.target.Name, math.floor(distance))
end

local function auraStep()
    if state.auraBlocked then return end
    local character, _, root = characterParts()
    local tool = character and character:FindFirstChild("Dragonstorm")
    if not tool or not tool:IsA("Tool") then state.aura = "Unequipped" return end
    local shotPart = chooseShotPart(root, collectTargets(root))
    if not shotPart then state.aura = "Ready; no nearby NPC" return end
    local remote, validator = getShotRemotes()
    if not remote or not validator then state.aura = "Waiting for gun remotes" return end
    local ready, reason = initDragon()
    if not ready then state.aura = reason return end
    if not state.running or state.teleporting or player.Character ~= character or tool.Parent ~= character then return end
    shootDragonstorm(tool, character, shotPart, remote, validator)
    state.aura = "Active"
end

function App:SetFarming(enabled)
    if not state.running then
        return
    end
    state.farming = enabled == true
    state.target = nil
    state.emptySince = nil
    if not state.farming then resetAutoCards(true) end
    releaseMovement()
    releaseV4Key()
    if state.farming then
        state.auraBlocked = false
        shootFunction, shotIndices = nil, nil
        nextInitAttempt = -math.huge
    end
    state.status = state.farming and "Starting dungeon farm" or "Farm paused"
    state.detail = state.farming and "Searching for Dragonstorm and nearby enemies." or "Movement paused. Equipped Dragonstorm aura remains active."
end

local function visibleGui(object)
    local current = object
    while current and current ~= playerGui do
        if current:IsA("GuiObject") and not current.Visible then return false end
        if current:IsA("ScreenGui") and not current.Enabled then return false end
        current = current.Parent
    end
    return current == playerGui
end

local function ensureContinuation()
    if queuedContinuation then return true end
    local queue = queue_on_teleport or queueonteleport
        or type(syn) == "table" and syn.queue_on_teleport
    if type(queue) ~= "function" then
        continuationError = "queue_on_teleport unavailable"
        return false
    end
    if type(writefile) ~= "function" or type(readfile) ~= "function" or type(makefolder) ~= "function" then
        continuationError = "Executor file APIs unavailable"
        return false
    end
    local source = environment.KaitunDungeonSource
    if type(source) ~= "string" or #source < 1000 then
        continuationError = "Run the complete bundled Lua"
        return false
    end
    local ok, err = pcall(function()
        if not isfolder("KaitunDungeon") then makefolder("KaitunDungeon") end
        writefile(sourcePath, source)
        if environment.KaitunTeleportQueued ~= game.JobId then
            local accepted = queue('local e=(getgenv and getgenv()) or _G; e.KaitunQueuedFromJob='
                .. string.format("%q", game.JobId) .. '; e.KaitunDungeonSource=readfile('
                .. string.format("%q", sourcePath) .. '); assert(loadstring(e.KaitunDungeonSource))()')
            assert(accepted ~= false, "Executor rejected the teleport reload queue.")
            environment.KaitunTeleportQueued = game.JobId
        end
    end)
    queuedContinuation, continuationReady = ok, ok
    continuationError = not ok and tostring(err) or nil
    return ok
end

local function savePartyProfile(config, enabled)
    if sharedStore then
        sharedStore:Write("profile-" .. player.UserId, { config = config, enabled = enabled == true, time = sharedClock() })
    end
end

local function startParty(config)
    if not partyRuntime then return false, syncError or "Shared file APIs are unavailable." end
    local okay, reason = partyRuntime:SetConfig(config)
    if not okay then return false, reason end
    partyWanted = true
    App:SetFarming(true)
    savePartyProfile(config, true)
    ensureContinuation()
    return partyRuntime:Start()
end

local function stopParty()
    if partyRuntime then partyRuntime:Stop() end
    partyWanted = false
    savePartyProfile(partyRuntime and partyRuntime.config, false)
    App:SetFarming(false)
end

local function initializeParty()
    local fs = { readfile = readfile, writefile = writefile, isfile = isfile,
        isfolder = isfolder, makefolder = makefolder, listfiles = listfiles }
    local codec = { encode = function(value) return HttpService:JSONEncode(value) end,
        decode = function(value) return HttpService:JSONDecode(value) end }
    sharedStore, syncError = SharedFiles.new(fs, codec, "KaitunDungeon")
    if not sharedStore then return end
    local function currentWorld()
        local character, _, root = characterParts()
        local room = root and roomAt(root)
        local phase = lobbyAdapter and lobbyAdapter:Phase() or "unknown"
        local loaded = phase ~= "dungeon" or dungeonFolder() ~= nil and workspace:FindFirstChild("Enemies") ~= nil
        return { jobId = game.JobId, placeId = game.PlaceId, phase = phase, alive = character ~= nil,
            ready = state.farming and character ~= nil
                and loaded and not state.teleporting and (phase ~= "lobby" or continuationReady),
            choosingCard = cardAuto.active, cardMovementBlocked = cardAuto.movementBlocked == true,
            movementTarget = root and state.target and (function()
                local descriptor = describeTarget(state.target, root)
                if descriptor then descriptor.object = nil end
                return descriptor
            end)() or nil,
            roomKey = room and room.key, teleporting = state.teleporting == true,
            position = root and { root.Position.X, root.Position.Y, root.Position.Z } or nil }
    end
    local function candidates()
        local _, _, root = characterParts()
        return root and describeTargets(collectTargets(root), root) or {}
    end
    local deps = { player = { userId = player.UserId, name = player.Name },
        sessionId = HttpService:GenerateGUID(false), storage = sharedStore, clock = sharedClock,
        world = currentWorld, targets = candidates,
        presentIds = function()
            local ids = {} for _, member in ipairs(Players:GetPlayers()) do ids[member.UserId] = true end return ids
        end,
        ensureContinuation = ensureContinuation,
        joinLobby = function(world, leader) return serverJoin:Step(world, leader) end,
        findEmptyPad = function(rejected) return lobbyAdapter:FindEmpty(rejected) end,
        readPad = function(key) return lobbyAdapter:Read(key) end,
        applyPad = function(decision, key) return lobbyAdapter:Apply(decision, key) end,
        abortPad = function(key, reason) if key then lobbyAdapter:Abort(key, reason) end end,
        getProof = function(key) return key and lobbyAdapter:Proof(key) end,
        checkEntry = function(key) return lobbyAdapter:EntryStep(key) end,
        checkOwnership = function(key) return lobbyAdapter:OwnershipStep(key) end,
        maintainPad = function(key) return lobbyAdapter:Maintain(key) end,
        leavePadMember = function(key) return lobbyAdapter:LeaveMember(key) end,
        onConfig = function(config)
            savePartyProfile(config, true)
            if partyForm then partyForm:Load(config, true) end
        end,
    }
    partyRuntime = PartyRuntime.new(deps, PartyCore, TargetRegistry, DungeonRecovery, LocalCombat)
    lobbyAdapter = LobbyAdapter.new({ workspace = workspace, players = Players, player = player,
        config = function() return partyRuntime.config end, clock = sharedClock,
        configEpoch = function() return partyRuntime.configEpoch end,
        leaderState = function() return partyRuntime.snapshot end,
        root = function() local _, humanoid, root = characterParts() return humanoid, root end,
        release = releaseMovement, ensureContinuation = ensureContinuation,
        queueVisible = function()
            local menu = playerGui:FindFirstChild("DungeonQueueSettingsMenu")
            if not menu or not visibleGui(menu) then return false end
            local frame = menu:FindFirstChild("RootFrame")
            return not frame or visibleGui(frame)
        end,
        publishProof = function(key, proof)
            local snapshot = partyRuntime.snapshot
            if snapshot and snapshot.padKey == key then
                snapshot.proof, snapshot.time = proof, sharedClock()
                sharedStore:Write("state-" .. partyRuntime.config.leaderId, snapshot)
            end
        end,
        move = function(goal)
            local _, _, root = characterParts()
            if not root then return false, "Waiting for your character." end
            if movementRoot ~= root then releaseMovement() movementRoot = root end
            if (root.Position - goal.Position).Magnitude < 1.5 then
                cancelTween()
                local velocity = root.AssemblyLinearVelocity
                if velocity then root.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0) end
                root.AssemblyAngularVelocity = Vector3.zero
                return true
            end
            if movementTween and movementTween.PlaybackState == Enum.PlaybackState.Playing
                and movementGoal and (movementGoal - goal.Position).Magnitude < 1 then return true end
            releaseMovement()
            movementRoot, movementGoal = root, goal.Position
            movementTween = TweenService:Create(root,
                TweenInfo.new(math.max((root.Position - goal.Position).Magnitude / Config.MoveSpeed, 0.1), Enum.EasingStyle.Linear),
                { CFrame = goal })
            movementTween:Play()
            return true
        end,
    }, PadSafety)
    ensureContinuation()
    local saved = sharedStore:Read("profile-" .. player.UserId, function(value)
        return PartyCore.ValidateConfig(value.config)
    end)
    if saved then
        partyRuntime:SetConfig(saved.config)
        if saved.enabled then startParty(saved.config) end
    end
end


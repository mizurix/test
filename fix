local PartyCore = (function()
-- Pure coordination rules. Only the configured leader publishes assignments.
local Party = {}
Party.Protocol = 1
Party.HeartbeatTTL = 3
Party.LeaseTTL = 1.5
Party.LeaseGrace = 0.3
Party.FollowerDelay = 0.1

local function validId(value)
    return type(value) == "number" and value > 0 and value % 1 == 0
end

function Party.NormalizeNames(leader, members, mode)
    local names, seen = {}, {}
    local function add(value, required)
        value = type(value) == "string" and value:match("^%s*(.-)%s*$") or ""
        value = value:gsub("^@", "")
        if value == "" then return not required, "Enter the leader's account username." end
        if not value:match("^[%w_]+$") then return false, "Use account usernames, not display names." end
        local key = value:lower()
        if seen[key] then return false, "Each account may appear only once." end
        seen[key] = true
        table.insert(names, value)
        return true
    end
    local ok, err = add(leader, true)
    if not ok then return nil, err end
    if type(members) ~= "table" or #members > 3 then return nil, "Use at most three member fields." end
    for index = 1, 3 do
        ok, err = add(members[index], false)
        if not ok then return nil, err end
    end
    local modes = { normal = "Normal", hard = "Hard", challenge = "Challenge" }
    mode = type(mode) == "string" and modes[mode:lower()] or nil
    if not mode then return nil, "Choose Normal, Hard, or Challenge." end
    return { names = names, count = #names, mode = mode }
end

function Party.ResolveConfig(normalized, resolve)
    local roster, ids = {}, {}
    for index, name in ipairs(normalized.names) do
        local ok, id = pcall(resolve, name)
        if not ok or not validId(id) then return nil, "Account lookup failed for " .. name .. "." end
        if ids[id] then return nil, "Two entries resolve to the same Roblox account." end
        ids[id] = true
        table.insert(roster, { name = name, userId = id, slot = index })
    end
    return { protocol = Party.Protocol, leaderId = roster[1].userId, roster = roster,
        count = #roster, mode = normalized.mode }
end

function Party.ValidateConfig(config)
    if type(config) ~= "table" or config.protocol ~= Party.Protocol or type(config.roster) ~= "table"
        or #config.roster < 1 or #config.roster > 4 or config.count ~= #config.roster then
        return false, "Invalid party configuration."
    end
    if config.mode ~= "Normal" and config.mode ~= "Hard" and config.mode ~= "Challenge" then
        return false, "Invalid dungeon mode."
    end
    local ids = {}
    for index, member in ipairs(config.roster) do
        if type(member) ~= "table" or not validId(member.userId) or type(member.name) ~= "string"
            or member.name == "" or member.slot ~= index or ids[member.userId] then
            return false, "Invalid or duplicate party account."
        end
        ids[member.userId] = true
    end
    if config.leaderId ~= config.roster[1].userId then return false, "Leader must occupy the first slot." end
    return true
end

function Party.Fresh(record, now, ttl)
    return type(record) == "table" and type(record.time) == "number"
        and record.time <= now + 1 and now - record.time <= (ttl or Party.HeartbeatTTL)
end

function Party.Member(config, userId)
    for _, member in ipairs(config.roster) do if member.userId == userId then return member end end
end

function Party.AllInLeaderServer(config, peers, leader, presentIds, now)
    local valid, reason = Party.ValidateConfig(config)
    if not valid then return false, reason end
    if not Party.Fresh(leader, now) or leader.userId ~= config.leaderId or leader.phase ~= "lobby"
        or type(leader.jobId) ~= "string" or leader.jobId == "" then
        return false, "Waiting for a fresh leader heartbeat in the verified lobby."
    end
    for _, member in ipairs(config.roster) do
        local peer = peers[tostring(member.userId)]
        if not Party.Fresh(peer, now) then return false, "Waiting for shared-workspace heartbeat: " .. member.name end
        if peer.userId ~= member.userId or type(peer.sessionId) ~= "string" or peer.sessionId == "" then
            return false, "Account identity/session mismatch: " .. member.name
        end
        if peer.jobId ~= leader.jobId or peer.placeId ~= leader.placeId or peer.phase ~= "lobby" then
            return false, "Waiting for " .. member.name .. " to join the leader's lobby server."
        end
        if peer.alive ~= true or peer.ready ~= true or not presentIds[member.userId] then
            return false, "Waiting for " .. member.name .. " to load and confirm party setup."
        end
    end
    return true
end

function Party.JoinDecision(config, peers, leader, presentIds, pad, userId, now)
    if not Party.Member(config, userId) then return { action = "wait", reason = "This account is not in the party." } end
    if pad and pad.safety == "abort" then return { action = "retry-empty-pad", reason = pad.reason } end
    if pad and pad.safety == "countdown" then return { action = "hold", reason = pad.reason } end
    local ready, reason = Party.AllInLeaderServer(config, peers, leader, presentIds, now)
    if not ready then return { action = "wait", reason = reason } end
    if type(pad) ~= "table" or not pad.verified or not pad.key then
        return { action = "wait", reason = "A verified lobby pad mapping is required." }
    end
    if pad.safety == "wait" then return { action = "wait", reason = pad.reason } end
    if pad.safety == "countdown" then return { action = "hold", reason = pad.reason } end
    if pad.ownerId and pad.ownerId ~= config.leaderId then
        return { action = "retry-empty-pad", reason = "Another player owns this pad." }
    end
    if not pad.ownerConfirmed then
        return { action = userId == config.leaderId and "leader-enter" or "wait",
            reason = "The leader must enter first and receive server confirmation." }
    end
    if pad.ownerId ~= config.leaderId then
        return { action = "wait", reason = "The server has not confirmed the configured party leader." }
    end
    local member = Party.Member(config, userId)
    if pad.menuReady == false then
        return { action = "hold", reason = "Waiting for the leader's join menu." }
    end
    if userId ~= config.leaderId then
        if pad.configured == false then
            return { action = "wait", reason = "Waiting for the leader's selected mode to be confirmed." }
        end
        if type(pad.confirmedAt) ~= "number" or now < pad.confirmedAt + (member.slot - 1) * Party.FollowerDelay then
            return { action = "wait", reason = "Waiting for the leader-first entry delay." }
        end
        if pad.insideIds and pad.insideIds[userId] then return { action = "hold", reason = "Party member is ready on the pad." } end
        for slot = 2, member.slot - 1 do
            if not pad.insideIds or not pad.insideIds[config.roster[slot].userId] then
                return { action = "wait", reason = "Waiting for the previous party member to finish entering." }
            end
        end
        return { action = "member-enter", padKey = pad.key }
    end
    if pad.mode ~= config.mode or pad.capacity ~= config.count or pad.configured == false then
        return { action = "configure", mode = config.mode, capacity = config.count,
            reason = "Verifying the selected dungeon mode." }
    end
    for _, expected in ipairs(config.roster) do
        if not pad.insideIds or not pad.insideIds[expected.userId] then
            return { action = "hold", reason = "Waiting for " .. expected.name .. " on the pad." }
        end
    end
    if pad.occupancy ~= config.count then
        return { action = "hold", reason = "Pad occupancy does not match the configured party size." }
    end
    return { action = "start", mode = config.mode, capacity = config.count, padKey = pad.key }
end

local function workerReady(config, member, peers, world, now)
    local peer = peers[tostring(member.userId)]
    return Party.Fresh(peer, now) and peer.userId == member.userId and type(peer.sessionId) == "string"
        and peer.sessionId ~= "" and peer.jobId == world.jobId and peer.placeId == world.placeId
        and peer.phase == "dungeon" and peer.alive == true and peer.ready == true
        and not (peer.choosingCard == true and peer.cardMovementBlocked ~= false)
        and (not world.roomKey or not peer.roomKey or peer.roomKey == world.roomKey)
end

function Party.AssignTargets(config, peers, world, targets, previous, now)
    local valid, reason = Party.ValidateConfig(config)
    if not valid then return nil, reason end
    if type(world) ~= "table" or type(world.epoch) ~= "string" or world.epoch == "" or type(world.startedAt) ~= "number"
        or type(world.jobId) ~= "string" or world.jobId == "" then return nil, "World identity is missing." end
    if now < world.startedAt + Party.LeaseTTL + Party.LeaseGrace then
        return {}, "Waiting for leases from the previous leader session to expire."
    end
    local available, leases, owners = {}, {}, {}
    for _, target in ipairs(targets) do
        if type(target.key) == "string" and target.alive then available[target.key] = target end
    end
    for key, lease in pairs(previous or {}) do
        local member = type(lease) == "table" and Party.Member(config, lease.ownerId)
        if member and lease.epoch == world.epoch and lease.jobId == world.jobId
            and type(lease.expiresAt) == "number" and available[key] then
            local peer = peers[tostring(member.userId)]
            if workerReady(config, member, peers, world, now) and peer.sessionId == lease.ownerSession
                and not (peer.unresolvedKey == key or peer.unresolved and not peer.unresolvedKey)
                and lease.expiresAt >= now and not owners[member.userId] then
                leases[key] = { targetKey = key, ownerId = member.userId, ownerSession = peer.sessionId,
                    epoch = world.epoch, jobId = world.jobId, placeId = world.placeId,
                    expiresAt = now + Party.LeaseTTL, revoked = false }
                owners[member.userId] = true
            elseif now <= lease.expiresAt + Party.LeaseGrace then
                -- Do not hand a cached lease to another account before it has expired.
                local retained = table.clone(lease)
                retained.revoked = true
                leases[key] = retained
            end
        end
    end
    local ordered = {}
    for key in pairs(available) do table.insert(ordered, key) end
    table.sort(ordered)
    for _, member in ipairs(config.roster) do
        if not owners[member.userId] and workerReady(config, member, peers, world, now) then
            for _, key in ipairs(ordered) do
                if not leases[key] then
                    local peer = peers[tostring(member.userId)]
                    leases[key] = { targetKey = key, ownerId = member.userId, ownerSession = peer.sessionId,
                        epoch = world.epoch, jobId = world.jobId, placeId = world.placeId,
                        expiresAt = now + Party.LeaseTTL, revoked = false }
                    owners[member.userId] = true
                    break
                end
            end
        end
    end
    return leases
end

function Party.OwnLease(leases, userId, sessionId, world, now)
    for _, lease in pairs(leases or {}) do
        if not lease.revoked and lease.ownerId == userId and lease.ownerSession == sessionId
            and lease.epoch == world.epoch and lease.jobId == world.jobId and lease.placeId == world.placeId
            and type(lease.expiresAt) == "number" and now < lease.expiresAt then return lease end
    end
end

function Party.AllClear(config, peers, world, enemyCount, now)
    if enemyCount ~= 0 then return false end
    local active = 0
    for _, member in ipairs(config.roster) do
        local peer = peers[tostring(member.userId)]
        if Party.Fresh(peer, now) and peer.jobId == world.jobId and peer.placeId == world.placeId
            and peer.phase == "dungeon" and peer.alive
            and (not world.roomKey or not peer.roomKey or peer.roomKey == world.roomKey) then
            if peer.enemyCount ~= 0 then return false end
            if peer.ready then active = active + 1 end
        end
    end
    return active > 0
end

return Party


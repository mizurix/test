local seenChecks = {}
local partyChecks = {
    ["party-start"] = "Party sync", ["settings-wait"] = "Party sync", ["party-wait"] = "Party sync",
    ["sync-error"] = "Party sync", ["joining-server"] = "Server check", ["join-retry"] = "Server join",
    ["continuation-wait"] = "Teleport check", ["leader-not-in-lobby"] = "Server check",
    ["dungeon-entry"] = "Dungeon entry", ["join-blocked"] = "Server join", ["dungeon-finish"] = "Dungeon check",
    ["leader-enter"] = "Leader check", ["member-enter"] = "Leader check", configure = "Mode check",
    start = "Start check", countdown = "Start check", ["pad-cancel"] = "Party check",
    ["pad-reentry"] = "Pad entry check",
    ["pad-ownership"] = "Leader check",
}
local function renderChecks(phase)
    local character = characterParts()
    local runtime = partyRuntime and partyRuntime.enabled and partyRuntime or nil
    local activeRoom = runtime and runtime.snapshot and runtime.snapshot.activeRoom
    local observer = activeRoom and tostring(activeRoom.userId) .. ":" .. activeRoom.sessionId
    local currentRoom = character and roomAt(select(3, characterParts()))
    local key, title, message, okay
    if not character then
        key, title, message = "respawning", "Respawn check", "Waiting for your character to respawn."
    elseif state.recoveringRoom then
        key, title, message = "recover:" .. state.recoveringRoom, "Room recovery", "Rejoining the party through the current room's exit."
    elseif seenChecks.recovering and currentRoom and currentRoom.key == seenChecks.recovering then
        key, title, message, okay = "rejoined:" .. seenChecks.recovering, "Room check", "Party room rejoined. Combat can resume.", true
    elseif runtime and partyChecks[runtime.stage] then
        key, title, message = "party:" .. runtime.stage, partyChecks[runtime.stage], runtime.status
        okay = runtime.stage == "countdown" or runtime.stage == "start" or runtime.stage == "member-enter"
    elseif state.auraBlocked then
        key, title, message = "attack-error", "Dragonstorm check", "Attack failed. Restart farming to retry."
    elseif state.status == "Dragonstorm not found" or state.aura == "Waiting for gun remotes" then
        key, title, message = "gun-dependency", "Dragonstorm check", state.status == "Dragonstorm not found" and "Waiting for Dragonstorm in the Backpack." or state.aura
    elseif returnToHub and (returnToHub.active or returnToHub.pendingUntil) then
        key, title, message = "hub-return", "Return check", "Skipping the completion countdown and waiting for the hub transfer."
    elseif cardAuto.error then
        key, title, message = "card-error:" .. cardAuto.error, "Card check", cardAuto.error
    elseif cardAuto.active then
        key, title, message = "card-choice", "Card check", "Choosing a gun upgrade or the random fallback."
    elseif observer and observer ~= seenChecks.observer then
        key, title, message, okay = "observer:" .. observer, "Combat sync", "A live party account is providing the active room's targets.", true
    elseif (state.objectiveCount or 0) > 0 and not seenChecks.objectives then
        key, title, message, okay = "objectives", "Objective check", "Boss objective hitboxes detected. Clearing them first.", true
    elseif phase ~= seenChecks.phase then
        key, title = "world:" .. phase, "Dungeon check"
        message = phase == "lobby" and "Dungeon lobby confirmed." or phase == "dungeon" and "Dungeon instance confirmed." or "Waiting for the dungeon map to load."
        okay = phase ~= "unknown"
    elseif character and seenChecks.alive == false then
        key, title, message, okay = "respawned", "Respawn check", "Character loaded. Checking the active party room.", true
    end
    if key then checks:Notify(key, title, message, okay) end
    seenChecks.phase, seenChecks.alive = phase, character ~= nil
    seenChecks.recovering, seenChecks.observer = state.recoveringRoom, observer
    seenChecks.objectives = (state.objectiveCount or 0) > 0
    checks:Update()
end


    for _, target in ipairs(candidates) do
        if target.alive and target.object then table.insert(live, target) end
    end
    table.sort(live, function(a, b)
        if a.name ~= b.name then return a.name < b.name end
        if (a.stableId ~= nil) ~= (b.stableId ~= nil) then return a.stableId ~= nil end
        if a.stableId and b.stableId and a.stableId ~= b.stableId then return tostring(a.stableId) < tostring(b.stableId) end
        for index = 1, 3 do
            if a.position[index] ~= b.position[index] then return a.position[index] < b.position[index] end
        end
        return false
    end)
    local function claimed(target, onlyHigherPriority)
        for _, other in ipairs(config.roster) do
            local peer = peers[tostring(other.userId)]
            if other.userId ~= userId and (not onlyHigherPriority or other.slot < member.slot)
                and rules.Fresh(peer, now) and peer.jobId == world.jobId and peer.placeId == world.placeId
                and peer.phase == "dungeon" and peer.alive and peer.ready
                and matches(target, peer.movementTarget) then return true end
        end
        return false
    end
    for _, target in ipairs(live) do
        if target.object == preferred and not claimed(target, true) then return target.object end
        if not claimed(target, false) then table.insert(unclaimed, target) end
    end
    local pool = #unclaimed > 0 and unclaimed or live
    if #pool > 0 then return pool[(member.slot - 1) % #pool + 1].object end
end

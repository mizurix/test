local PartyRuntime = (function()
-- Client actor for a shared executor workspace. Inject real world/pad adapters.
local Runtime = {}
Runtime.__index = Runtime

function Runtime.new(deps, rules, registryClass, recovery, combat)
    return setmetatable({ deps = deps, rules = rules, registryClass = registryClass,
        recovery = recovery, combat = combat,
        enabled = false, status = "Party setup is not started.", lastPoll = -math.huge,
        lastTeleport = -math.huge, leases = {}, peers = {}, rejectedPads = {} }, Runtime)
end

function Runtime:SetConfig(config)
    local ok, err = self.rules.ValidateConfig(config)
    if not ok then return false, err end
    if not self.rules.Member(config, self.deps.player.userId) then return false, "This account is not included in the party." end
    if self.enabled then self:Stop() end
    self.config = config
    self.requestedLeader = config.leaderId
    return true
end

function Runtime:Start()
    if not self.config then return false, "Confirm account usernames first." end
    self.enabled = true
    self.epoch = self.deps.sessionId .. "-" .. tostring(self.deps.clock())
    self.configEpoch = self.epoch

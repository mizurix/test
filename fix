    self.selectedPad = nil
    self.snapshot, self.cachedTarget, self.cancelUntil = nil, nil, nil
    self.unresolved, self.unresolvedKey, self.observerId = false, nil, nil
    self.rejectedPads = {}
    self.joinRequest, self.joinAttempts, self.nextJoinAt = nil, 0, 0
    self.joinBlocked = nil
    self.stage = "party-start"
    self.status = "Verifying shared workspace and leader server."
    return true
end

function Runtime:Stop()
    if self.selectedPad and self.deps.abortPad then self.deps.abortPad(self.selectedPad, "Party stopped.") end
    if self.enabled and self.config then
        if self.config.leaderId == self.deps.player.userId then
            self.deps.storage:Write("settings-" .. self.config.leaderId,
                { time = self.deps.clock(), epoch = self.configEpoch, enabled = false, config = self.config })
        end
        if self.heartbeat then
            self.heartbeat.ready = false
            self.heartbeat.time = self.deps.clock()
            self.deps.storage:Write("peer-" .. self.config.leaderId .. "-" .. self.deps.player.userId, self.heartbeat)
        end
    end
    self.enabled, self.snapshot, self.cachedTarget = false, nil, nil
    self.joinRequest, self.stage = nil, "stopped"
    self.status = "Party coordination stopped."
end

function Runtime:_settings(now)
    local deps, leaderId = self.deps, self.requestedLeader
    if leaderId == deps.player.userId then
        local ok, err = deps.storage:Write("settings-" .. leaderId,
            { time = now, epoch = self.configEpoch, enabled = true, config = self.config })
        if not ok then return false, "Cannot publish party settings: " .. tostring(err) end
        return true
    end
    local settings = deps.storage:Read("settings-" .. leaderId, function(value)
        return self.rules.Fresh(value, now) and type(value.epoch) == "string"
            and self.rules.ValidateConfig(value.config) and value.config.leaderId == leaderId
    end)
    if not settings then return false, "Leader settings are not visible. Shared workspace may be unavailable." end
    if not settings.enabled then return false, "The leader has stopped party coordination." end
    if not self.rules.Member(settings.config, deps.player.userId) then return false, "The leader has not included this account." end
    if self.configEpoch ~= settings.epoch then
        self.snapshot, self.cachedTarget, self.leases = nil, nil, {}
        self.config, self.configEpoch = settings.config, settings.epoch
        if deps.onConfig then deps.onConfig(self.config) end
    end
    return true
end

function Runtime:_peers(now, world, candidates)
    local deps, config = self.deps, self.config
    local reportKey = deps.sessionId .. ":" .. world.jobId .. ":" .. world.placeId
    if self.reportKey ~= reportKey then
        self.reportKey = reportKey
        self.reportRegistry = self.registryClass.new(reportKey)
    end
    local report = self.reportRegistry:Snapshot(candidates)
    while #report > 96 do table.remove(report) end
    self.heartbeat = {
        time = now, userId = deps.player.userId, name = deps.player.name, sessionId = deps.sessionId,
        configEpoch = self.configEpoch, jobId = world.jobId, placeId = world.placeId, phase = world.phase,
        alive = world.alive == true, ready = world.ready == true, choosingCard = world.choosingCard == true,
        cardMovementBlocked = world.cardMovementBlocked, movementTarget = world.movementTarget,
        enemyCount = #candidates, unresolved = self.unresolved == true, unresolvedKey = self.unresolvedKey,
        targets = report, roomKey = world.roomKey, position = world.position,
        assignmentEpoch = self.snapshot and self.snapshot.world and self.snapshot.world.epoch or nil,
    }
    local ok, err = deps.storage:Write("peer-" .. config.leaderId .. "-" .. deps.player.userId, self.heartbeat)
    if not ok then return false, "Cannot publish account heartbeat: " .. tostring(err) end
    local peers = {}
    for _, member in ipairs(config.roster) do
        local peer = deps.storage:Read("peer-" .. config.leaderId .. "-" .. member.userId, function(value)
            return self.rules.Fresh(value, now) and value.userId == member.userId and value.configEpoch == self.configEpoch
        end)
        if peer then peers[tostring(member.userId)] = peer end
    end
    self.peers = peers
    return true
end

function Runtime:_serverJoin(now, world, leader)
    -- A finishing instance returns through its own completion screen. The
    -- leader arriving in the hub must never initiate a second transfer here.
    if world.teleporting then return false end
    if world.phase == "dungeon" then
        self.joinRequest, self.joinAttempts, self.nextJoinAt = nil, 0, 0
        return false
    end
    if not leader or not self.rules.Fresh(leader, now) then return false end
    if leader.jobId == world.jobId and leader.placeId == world.placeId then
        self.joinRequest, self.joinAttempts, self.nextJoinAt, self.joinBlocked = nil, 0, 0, nil
        return false
    end
    self.stage = "joining-server"
    self.status = "Joining the leader's lobby server."
    if leader.phase ~= "lobby" then self.stage, self.status = "leader-not-in-lobby", "Leader is not in a joinable lobby. Waiting for the party." return true end
    if type(leader.jobId) ~= "string" or leader.jobId == "" or type(leader.placeId) ~= "number" or leader.placeId <= 0 then
        self.status = "Waiting for a valid leader place ID and job ID." return true
    end
    local destination = tostring(leader.placeId) .. ":" .. leader.jobId
    if self.joinBlocked == destination then
        self.stage, self.status = "join-blocked", self.joinFailure
        return true
    end
    local request = self.joinRequest
    if request then
        if now - request.time < 20 then return true end
        self:OnTeleportFailed("Teleport did not complete within 20 seconds.", request.placeId)
    end
    if now < (self.nextJoinAt or 0) then self.stage = "join-retry" self.status = self.joinFailure or "Waiting to retry leader-server join." return true end
    if not self.deps.ensureContinuation() then
        self.stage = "continuation-wait"
        self.status = "Automatic re-execution API is unavailable; server joining is waiting."
        return true
    end
    self.lastTeleport = now
    self.joinAttempts = (self.joinAttempts or 0) + 1
    self.joinRequest = { jobId = leader.jobId, placeId = leader.placeId, time = now }
    local request = self.joinRequest
    if self.deps.joinLobby then
        local ok, result = pcall(self.deps.joinLobby, world, leader)
        if not ok then self:OnTeleportFailed(tostring(result), leader.placeId)
        elseif not result or not result.sent then
            if self.joinRequest == request then self.joinRequest = nil end
            self.joinAttempts = math.max(self.joinAttempts - 1, 0)
            self.stage, self.status = result and result.stage or "dungeon-entry", result and result.message or "Waiting for normal dungeon entry."
        elseif self.joinRequest == request then
            request.method = result.method
            self.status = "Requested the leader's server through the game's Server Browser."
        end
    else
        -- Compatibility for dependency-injected transport fixtures.
        local ok, err = pcall(self.deps.teleport, leader.placeId, leader.jobId)
        if not ok then self:OnTeleportFailed(tostring(err), leader.placeId) end
    end
    return true
end

function Runtime:OnTeleportFailed(message, placeId)
    if not self.enabled then return end
    local now, request = self.deps.clock(), self.joinRequest
    if request then
        if placeId and placeId ~= request.placeId then return end
        self.joinRequest = nil
        local lower = tostring(message):lower()
        if lower:find("teleport token", 1, true) or lower:find("not authorized", 1, true)
            or lower:find("not authorised", 1, true) or lower:find("unauthorized", 1, true) then
            self.joinBlocked = tostring(request.placeId) .. ":" .. request.jobId
            self.nextJoinAt = 0
            self.joinFailure = "The game's join service rejected this destination: " .. tostring(message)
            self.stage, self.status = "join-blocked", self.joinFailure
            return
        end
        local backoff = math.min(2 ^ math.min((self.joinAttempts or 1) - 1, 3), 8)
        self.nextJoinAt = now + backoff
        self.joinFailure = "Leader-server join failed; retrying in " .. backoff .. "s: " .. tostring(message)
        self.stage, self.status = "join-retry", self.joinFailure
    elseif self.selectedPad then
        local key, world = self.selectedPad, self.deps.world()
        self.deps.abortPad(key, tostring(message))
        self.stage, self.status = "pad-cancel", "Dungeon teleport failed: " .. tostring(message)
        if self.config.leaderId == self.deps.player.userId then
            self.snapshot = { time = now, configEpoch = self.configEpoch, phase = "lobby", jobId = world.jobId,
                placeId = world.placeId, padKey = key, decision = "abort", reason = self.status }
            self.deps.storage:Write("state-" .. self.config.leaderId, self.snapshot)
            self.rejectedPads[key], self.selectedPad, self.cancelUntil = now, nil, now + 2
        end
    end
end

function Runtime:_lobby(now, world, leader)
    local config, deps = self.config, self.deps
    local isLeader = deps.player.userId == config.leaderId
    if isLeader and now < (self.cancelUntil or 0) then
        if self.snapshot and self.snapshot.decision == "abort" then
            self.snapshot.time = now
            deps.storage:Write("state-" .. config.leaderId, self.snapshot)
        end
        return -- Keep cancellation visible long enough for delayed followers.
    end
    local allHere, reason = self.rules.AllInLeaderServer(config, self.peers, leader, deps.presentIds(), now)
    if allHere and isLeader and not self.selectedPad and now >= (self.cancelUntil or 0) then
        self.selectedPad = deps.findEmptyPad(self.rejectedPads)
        if self.selectedPad then self.padSelectedAt = now end
    end
    local leaderState = self.snapshot
    local key = self.selectedPad
    if not isLeader then key = leaderState and leaderState.padKey end
    self.selectedPad = key
    local pad = key and deps.readPad(key) or nil
    local abortReason = pad and pad.safety == "abort" and pad.reason
        or (not isLeader and leaderState and leaderState.decision == "abort" and leaderState.reason)
    if key and not allHere and not (pad and pad.safety == "countdown") then abortReason = reason end
    if isLeader and key and self.padSelectedAt and now - self.padSelectedAt > 35 and not (pad and pad.preparing) then
        abortReason = "Pad setup timed out; stepping off and retrying."
    end
    if abortReason then
        self.stage = "pad-cancel"
        if deps.abortPad then deps.abortPad(key, abortReason) end
        self.status = abortReason
        if isLeader then
            self.snapshot = { time = now, configEpoch = self.configEpoch, phase = "lobby", jobId = world.jobId,
                placeId = world.placeId, padKey = key, decision = "abort", reason = abortReason }
            deps.storage:Write("state-" .. config.leaderId, self.snapshot)
            if key then self.rejectedPads[key] = now end
            self.selectedPad, self.cancelUntil = nil, now + 2
        end
        return
    end
    if not allHere and not (pad and pad.safety == "countdown") then self.stage, self.status = "party-wait", reason return end
    if not isLeader and key and leaderState
        and (leaderState.decision == "recover-owner" or leaderState.decision == "verify-owner") then
        self.stage, self.status = "pad-ownership", leaderState.reason
        if leaderState.decision == "recover-owner" and deps.leavePadMember then deps.leavePadMember(key)
        elseif deps.maintainPad then deps.maintainPad(key) end
        return
    end
    if isLeader and key and deps.checkOwnership then
        local ownership = deps.checkOwnership(key)
        if ownership then
            self.stage, self.status = "pad-ownership", ownership.reason
            self.snapshot = { time = now, configEpoch = self.configEpoch, phase = "lobby", jobId = world.jobId,
                placeId = world.placeId, padKey = key, decision = ownership.action, reason = ownership.reason,
                proof = deps.getProof and deps.getProof(key) or nil }
            deps.storage:Write("state-" .. config.leaderId, self.snapshot)
            if ownership.action == "abort" then
                deps.abortPad(key, ownership.reason)
                self.rejectedPads[key], self.selectedPad, self.cancelUntil = now, nil, now + 2
            elseif deps.maintainPad then deps.maintainPad(key) end
            return
        end
        pad = deps.readPad(key)
    end
    if isLeader and key and deps.checkEntry then
        local held, entryReason, failed = deps.checkEntry(key)
        if held then
            self.stage, self.status = "pad-reentry", entryReason
            self.snapshot = { time = now, configEpoch = self.configEpoch, phase = "lobby", jobId = world.jobId,
                placeId = world.placeId, padKey = key, decision = failed and "abort" or "hold", reason = entryReason,
                proof = deps.getProof and deps.getProof(key) or nil }
            deps.storage:Write("state-" .. config.leaderId, self.snapshot)
            if failed then
                deps.abortPad(key, entryReason)
                self.rejectedPads[key], self.selectedPad, self.cancelUntil = now, nil, now + 2
            end
            return
        end
        pad = deps.readPad(key)
    end
    if key and deps.maintainPad then deps.maintainPad(key) end
    local decision = self.rules.JoinDecision(config, self.peers, leader, deps.presentIds(), pad, deps.player.userId, now)
    self.status = decision.reason or decision.action
    self.stage = pad and pad.safety == "countdown" and "countdown" or decision.action
    if isLeader then
        self.snapshot = { time = now, configEpoch = self.configEpoch, phase = "lobby", jobId = world.jobId,
            placeId = world.placeId, padKey = self.selectedPad, decision = decision.action,
            proof = deps.getProof and deps.getProof(key) or nil }
        deps.storage:Write("state-" .. config.leaderId, self.snapshot)
    end
    if decision.action == "retry-empty-pad" and isLeader then
        if deps.abortPad then deps.abortPad(key, decision.reason) end
        self.rejectedPads[self.selectedPad] = now
        self.selectedPad, self.cancelUntil = nil, now + 2
    elseif decision.action == "leader-enter" or decision.action == "member-enter"
        or decision.action == "configure" or decision.action == "start" then
        local ok, err = deps.applyPad(decision, key)
        if ok == false then self.status = err or "Pad action is waiting for verified game controls." end
    end
end

function Runtime:_dungeon(now, world, candidates)
    local deps, config = self.deps, self.config
    if deps.player.userId == config.leaderId then
        local observer = self.recovery and self.recovery.Observer(config, self.peers, world,
            self.observerId, self.rules, now) or nil
        if not self.recovery then observer = self.peers[tostring(config.leaderId)] end
        self.observerId = observer and observer.userId or self.observerId
        local source = observer and observer.sessionId or self.lastSource or deps.sessionId
        self.lastSource = source
        local worldKey = self.configEpoch .. ":" .. world.jobId .. ":" .. world.placeId .. ":" .. source
        if self.worldKey ~= worldKey then
            self.worldKey = worldKey
            self.world = { epoch = worldKey, jobId = world.jobId, placeId = world.placeId, startedAt = now }
            self.leases = {}
        end
        self.world.roomKey = observer and observer.roomKey or nil
        if self.recovery and self.recovery.Acknowledged(config, self.peers, self.world, self.rules, now) then
            self.world.startedAt = math.min(self.world.startedAt, now - self.rules.LeaseTTL - self.rules.LeaseGrace)
        end
        local descriptors = observer and observer.targets or {}
        self.leases = assert(self.rules.AssignTargets(config, self.peers, self.world, descriptors, self.leases, now))
        self.snapshot = { time = now, configEpoch = self.configEpoch, phase = "dungeon", world = self.world,
            jobId = world.jobId, placeId = world.placeId, targets = descriptors, leases = self.leases,
            allClear = self.rules.AllClear(config, self.peers, self.world, #descriptors, now),
            activeRoom = observer and { userId = observer.userId, sessionId = observer.sessionId,
                roomKey = observer.roomKey, position = observer.position, enemyCount = observer.enemyCount } or nil }
        deps.storage:Write("state-" .. config.leaderId, self.snapshot)
    end
    local snapshot = self.snapshot
    self.stage = "target-wait"
    if not snapshot or snapshot.phase ~= "dungeon" or not self.rules.Fresh(snapshot, now, self.rules.LeaseTTL)
        or snapshot.jobId ~= world.jobId or snapshot.placeId ~= world.placeId then
        self.status, self.cachedTarget = "Waiting for fresh leader target assignments.", nil
        return
    end
    local lease = self.rules.OwnLease(snapshot.leases, deps.player.userId, deps.sessionId, snapshot.world, now)
    if not lease then
        self.unresolved, self.unresolvedKey = false, nil
        self.status, self.cachedTarget = snapshot.allClear and "Party room clear." or "Waiting for an available enemy assignment.", nil
        return
    end
    local descriptor
    for _, target in ipairs(snapshot.targets) do if target.key == lease.targetKey then descriptor = target break end end
    if not descriptor then self.status, self.cachedTarget = "Assigned enemy disappeared from the leader view.", nil return end
    local object, reason
    object = self.reportRegistry.live[lease.targetKey]
    if not object then object, reason = self.registryClass.Resolve(descriptor, candidates,
        self.cachedTargetKey == lease.targetKey and self.cachedTarget or nil) end
    self.unresolved = object == nil
    self.unresolvedKey = object == nil and lease.targetKey or nil
    self.cachedTarget, self.cachedTargetKey = object, lease.targetKey
    self.status = object and "Assigned: " .. descriptor.name or reason
    self.stage = object and (descriptor.objective and "objectives" or "fighting") or "target-wait"
end

function Runtime:Tick(force)
    if not self.enabled then return end
    local deps, now = self.deps, self.deps.clock()
    if deps.world().teleporting then return end
    if not force and now - self.lastPoll < 0.25 then return end
    self.lastPoll = now
    local ready, reason = self:_settings(now)
    if not ready then
        self.coordinationAllowed = false
        self.stage = "settings-wait"
        if self.selectedPad and deps.abortPad then deps.abortPad(self.selectedPad, reason) end
        self.status, self.snapshot, self.cachedTarget = reason, nil, nil
        return
    end
    self.coordinationAllowed = true
    local world = deps.world()
    local candidates = world.phase == "dungeon" and deps.targets() or {}
    ready, reason = self:_peers(now, world, candidates)
    if not ready then self.stage, self.status, self.cachedTarget = "sync-error", reason, nil return end
    local leader = self.peers[tostring(self.config.leaderId)]
    if deps.player.userId ~= self.config.leaderId then
        if self:_serverJoin(now, world, leader) then self.snapshot, self.cachedTarget = nil, nil return end
        self.snapshot = deps.storage:Read("state-" .. self.config.leaderId, function(value)
            return value.configEpoch == self.configEpoch and self.rules.Fresh(value, now)
                and value.jobId == world.jobId and value.placeId == world.placeId
        end)
    end
    if world.phase == "lobby" then
        self.cachedTarget = nil
        self:_lobby(now, world, leader)
    elseif world.phase == "dungeon" then self:_dungeon(now, world, candidates)
    else self.status, self.cachedTarget = "Enter the dungeon lobby using the game's Server Browser > Dungeon tab.", nil end
end

function Runtime:GetTarget()
    if not self.enabled or not self.snapshot or not self.cachedTarget then return nil, self.status end
    local snapshot, now = self.snapshot, self.deps.clock()
    local current = self.deps.world()
    if not current.alive or not current.ready or current.choosingCard and current.cardMovementBlocked ~= false then
        return nil, "Character is not ready for combat."
    end
    if snapshot.phase ~= "dungeon" or snapshot.jobId ~= current.jobId or snapshot.placeId ~= current.placeId
        or not self.rules.Fresh(snapshot, now, self.rules.LeaseTTL) then return nil, "Leader assignment expired." end
    local lease = self.rules.OwnLease(snapshot.leases, self.deps.player.userId, self.deps.sessionId, snapshot.world, now)
    if not lease or lease.targetKey ~= self.cachedTargetKey then return nil, "Target lease expired." end
    return self.cachedTarget
end

function Runtime:GetRecoveryGoal()
    if not self.enabled or not self.recovery then return end
    local current = self.deps.world()
    current.enemyCount = self.heartbeat and self.heartbeat.enemyCount or 0
    return self.recovery.Goal(self.snapshot, current, self.peers, self.rules, self.deps.clock())
end

function Runtime:SelectLocalTarget(candidates, preferred)
    if not self.enabled or not self.coordinationAllowed or not self.combat then return end
    local world = self.deps.world()
    if world.phase ~= "dungeon" or world.teleporting
        or world.choosingCard and world.cardMovementBlocked ~= false then return end
    return self.combat.Select(self.config, self.deps.player.userId, self.peers, world,
        candidates, preferred, self.rules, self.deps.clock())
end

function Runtime:CanAdvance()
    local current, own, now = self.deps.world(), self.heartbeat, self.deps.clock()
    return self.enabled and self.coordinationAllowed and current.phase == "dungeon" and current.alive and current.ready
        and not current.choosingCard and self.rules.Fresh(own, now, self.rules.LeaseTTL)
        and own.jobId == current.jobId and own.placeId == current.placeId and own.roomKey == current.roomKey
        and self.rules.AllClear(self.config, self.peers, current, own.enemyCount, now)
end

return Runtime

end)()

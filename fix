local function autoCardStep()
    if not state.farming then return false end
    local now = os.clock()
    if now - cardAuto.lastScan < Config.CardScanInterval then return cardAuto.active end
    cardAuto.lastScan = now
    local choices = collectCards()
    if #choices == 0 then
        if cardAuto.active then
            cardAuto.missingSince = cardAuto.missingSince or now
            if now - cardAuto.missingSince >= 0.2 then resetAutoCards(true) end
        end
        return cardAuto.active
    end
    cardAuto.missingSince = nil
    local signatureParts = {}
    for _, choice in ipairs(choices) do table.insert(signatureParts, choice.text) end
    table.sort(signatureParts)
    local signature = table.concat(signatureParts, "\n")
    if cardAuto.active and signature ~= cardAuto.signature then
        releaseCardMouse()
        cardAuto.token = cardAuto.token + 1
        cardAuto.button, cardAuto.attempts, cardAuto.seenAt, cardAuto.error = nil, 0, now, nil
    end
    cardAuto.signature = signature
    if not cardAuto.active then
        cardAuto.active, cardAuto.seenAt = true, now
        cardAuto.wasVisible = ui.host and ui.host.Visible or false

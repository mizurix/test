    if type(first) == "string" and second ~= nil then
        return second
    end
    return first
end

local function shotValues(callback, indices)
    local values = {}
    for name, index in pairs(indices) do
        local value = readUpvalue(callback, index)
        if type(value) ~= "number" or value ~= value or math.abs(value) == math.huge then
            return nil
        end
        values[name] = value
    end
    if values.modulus <= 0 or values.limit <= 0 then
        return nil
    end
    return values
end

local function initDragon()
    if shootFunction then
        return true
    end
    if os.clock() < nextInitAttempt then
        return false, initMessage
    end
    nextInitAttempt = os.clock() + 1
    if type(debug) ~= "table" or type(debug.getupvalues) ~= "function"
        or type(debug.getupvalue) ~= "function" or type(debug.setupvalue) ~= "function" then
        initMessage = "This attack method requires debug.getupvalues/getupvalue/setupvalue."
        return false, initMessage
    end
    local controllers = ReplicatedStorage:FindFirstChild("Controllers")
    local module = controllers and controllers:FindFirstChild("CombatController")
    if not module then
        initMessage = "Waiting for ReplicatedStorage.Controllers.CombatController."
        return false, initMessage
    end
    local ok, err = pcall(function()
        local controller = require(module)
        if type(controller) ~= "table" or type(controller.Attack) ~= "function" then
            return
        end
        for _, candidate in pairs(debug.getupvalues(controller.Attack)) do
            if type(candidate) == "function" then
                for index, value in pairs(debug.getupvalues(candidate)) do
                    if value == 727595 and type(index) == "number" and index >= 4 then
                        local indices = {
                            low = index - 3, multiplier2 = index - 2, high = index - 1,
                            multiplier = index, modulus = index + 1,
                            limit = index + 2, counter = index + 3,
                        }
                        if shotValues(candidate, indices) then
                            shootFunction, shotIndices = candidate, indices
                            return
                        end
                    end
                end
            end
        end
    end)
    if not ok then
        initMessage = "Attack initialization: " .. tostring(err)
    elseif not shootFunction then
        initMessage = "Dragonstorm shooting closure was not found; controller layout may have changed."
    else
        initMessage = "Dragonstorm attack ready."
    end
    return shootFunction ~= nil, initMessage
end


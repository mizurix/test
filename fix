local function cardVisible(button)
    if button.Active == false then return false end
    local x = button.AbsolutePosition.X + button.AbsoluteSize.X / 2
    local y = button.AbsolutePosition.Y + button.AbsoluteSize.Y / 2
    local current = button
    local screen
    while current and current ~= playerGui do
        if current:IsA("GuiObject") and not current.Visible then return false end
        if current:IsA("CanvasGroup") and current.GroupTransparency >= 0.99 then return false end
        if current:IsA("ScreenGui") and not current.Enabled then return false end
        if current:IsA("ScreenGui") then screen = current end
        if current:IsA("GuiObject") and current.ClipsDescendants then
            local position, size = current.AbsolutePosition, current.AbsoluteSize
            if x < position.X or y < position.Y or x > position.X + size.X or y > position.Y + size.Y then return false end
        end
        current = current.Parent
    end
    if screen and not screen.IgnoreGuiInset then
        local inset = GuiService:GetGuiInset()
        x, y = x + inset.X, y + inset.Y
    end
    local camera = workspace.CurrentCamera
    if camera and (x < 0 or y < 0 or x > camera.ViewportSize.X or y > camera.ViewportSize.Y) then return false end
    return current == playerGui and button.AbsoluteSize.X > 2 and button.AbsoluteSize.Y > 2
end


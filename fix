function App:Shutdown()
    if not state.running then
        return
    end

    if partyRuntime then partyRuntime:Stop() end
    self:SetFarming(false)
    state.running = false
    if ui.showTween then
        ui.showTween:Cancel()
        ui.showTween = nil
    end
    if checks then checks:Hide() end
    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end
    table.clear(connections)
    if ui.gui then
        ui.gui:Destroy()
    end
    if environment[sessionKey] == self then
        environment[sessionKey] = nil
    end
end


local ClientBootstrap = (function()
-- Teleport queues can run before the destination has created LocalPlayer/PlayerGui.
local Bootstrap = {}
function Bootstrap.Wait(deps)
    local deadline = deps.clock() + (deps.timeout or 60)
    local waitingFor = "client initialization"
    while true do
        local loaded, client = deps.loaded(), deps.client()
        local player = deps.player()
        local job = deps.job and deps.job() or nil
        if not loaded then waitingFor = "the destination game to load"
        elseif not client then waitingFor = "a client execution context"
        elseif deps.job and (not job or job == "") then waitingFor = "the destination server ID"
        elseif deps.previousJob and job == deps.previousJob then waitingFor = "the destination teleport context"
        elseif not player then waitingFor = "LocalPlayer"
        else
            local gui = deps.gui(player)
            if gui then return player, gui end
            waitingFor = "PlayerGui"
        end
        if deps.clock() >= deadline then
            error("Kaitun Dungeon: teleport startup timed out waiting for " .. waitingFor .. ".", 0)
        end
        deps.wait(0.1)
    end
end
return Bootstrap


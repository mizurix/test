local function activateGameButton(button, attempt, clearedPanel)
    local useSignal = type(firesignal) == "function" and attempt <= 2
    if not useSignal then
        if not windowFocused then return false, "Game button is waiting for Roblox focus.", false end
        if not VirtualInputManager then return false, "Game button needs a supported GUI activation API.", false end
        if ui.host.Visible then
            if clearedPanel then clearedPanel() end
            hidePanel()
            return false, "Clearing the main panel from the game button.", false
        end
    end
    local attempted = false
    local ok, reason = pcall(function()
        if useSignal then
            local signalName = attempt == 2 and "Activated" or "MouseButton1Click"
            if type(getconnections) == "function" and attempt == 1
                and #getconnections(button.MouseButton1Click) == 0 and #getconnections(button.Activated) > 0 then signalName = "Activated" end
            attempted = true
            firesignal(button[signalName])
            return
        end
        local screen = button.Parent
        while screen and not screen:IsA("ScreenGui") do screen = screen.Parent end
        assert(screen, "Game screen changed; waiting for its button.")
        local x, y = cardClickPosition({ button = button, screen = screen })
        assert(x, "Game button is covered by another UI.")
        releaseCardMouse()
        local token = cardAuto.token
        cardAuto.mouseX, cardAuto.mouseY, cardAuto.mouseHeld = x, y, true
        attempted = true
        VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.delay(0.05, function() if cardAuto.token == token then releaseCardMouse() end end)
    end)
    if not ok then releaseCardMouse() end
    return ok, reason, attempted
end
